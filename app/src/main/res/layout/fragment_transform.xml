<?xml version="1.0" encoding="utf-8"?>
<!-- Transform tab: 90° rotation and crop entry. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rotateLeftButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:contentDescription="@string/rotate_left"
                android:text="@string/rotate_left"
                app:icon="@drawable/ic_rotate_left"
                app:iconGravity="textStart"
                app:iconTint="@color/pc_text_primary"
                app:strokeColor="@color/pc_outline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rotateRightButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:contentDescription="@string/rotate_right"
                android:text="@string/rotate_right"
                app:icon="@drawable/ic_rotate_right"
                app:iconGravity="textStart"
                app:iconTint="@color/pc_text_primary"
                app:strokeColor="@color/pc_outline" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cropButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/crop"
            android:textColor="@color/pc_on_accent"
            app:backgroundTint="@color/pc_accent"
            app:icon="@drawable/ic_crop"
            app:iconGravity="textStart"
            app:iconTint="@color/pc_on_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/transform_hint"
            android:textColor="@color/pc_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
