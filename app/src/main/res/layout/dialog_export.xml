<?xml version="1.0" encoding="utf-8"?>
<!-- Custom body of the "Export image" dialog: format choice + JPEG quality. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <RadioGroup
        android:id="@+id/exportFormatGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/jpegRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/export_format_jpeg"
            android:textColor="@color/pc_text_primary" />

        <RadioButton
            android:id="@+id/pngRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/export_format_png"
            android:textColor="@color/pc_text_primary" />
    </RadioGroup>

    <TextView
        android:id="@+id/exportQualityLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/export_quality_label"
        android:textColor="@color/pc_text_secondary"
        android:textSize="12sp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/exportQualitySlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stepSize="1"
        android:valueFrom="10"
        android:valueTo="100" />

    <TextView
        android:id="@+id/exportQualityValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/pc_text_secondary"
        android:textSize="12sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="8dp" />
</LinearLayout>
